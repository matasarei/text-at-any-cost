{
  "name": "matasarei/text-at-any-cost",
  "description": "Text at any cost: get text from any office document (DOC, DOCX, ODT, PDF and other).",
  "homepage": "https://github.com/matasarei/text-at-any-cost",
  "minimum-stability": "stable",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "ext-zip": "*",
    "ext-dom": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "TextAtAnyCost\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TextAtAnyCost\\Tests\\": "tests/"
    }
  }
}
